# price distribution category
def category(price):
     if price < 2:
         return"Budget"
     elif price < 5:
         return "Mid segment"
     elif price < 10:
         return "Premium"
     elif price < 20:
         return "Luxury"

df['Price category'] = df['price'].apply(category)
print('price distribution category and count')
print(df['Price category'])
print(df['Price category'].value_counts())

# pie chart of price category
df['Price category'].value_counts().plot(kind='pie',autopct='%1.1f%%')
plt.ylabel('')
plt.title("Price category distribution")
plt.show()
